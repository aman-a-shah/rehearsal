{
  "name": "rehearsal",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix web run build",
    "test": ".venv/bin/python -m pytest tests -q",
    "test:e2e": "node scripts/check.mjs",
    "test:live": "node scripts/check-live.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "demo:export": ".venv/bin/python scripts/export-demo.py",
    "runner:build": "docker build -t rehearsal-runner:local runner",
    "test:repositories": ".venv/bin/python -m pytest tests/test_repositories.py tests/test_repo_examples.py -q",
    "test:identity": "node --test scripts/test-sandbox-identity.mjs"
  }
}
