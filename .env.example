# The guided rehearsal needs no API key.
REHEARSAL_PROVIDER=backboard
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=anthropic
REHEARSAL_MODEL=claude-sonnet-4-6
# Optional: reuse an existing Backboard assistant for incident memory.
# BACKBOARD_ASSISTANT_ID=
# Maximum reported inference spend per rehearsal (USD).
REHEARSAL_RUN_BUDGET_USD=1.00
# The legacy Anthropic adapter is also supported with REHEARSAL_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# Optional external FalkorDB; otherwise the embedded local server is used.
# FALKORDB_URL=redis://127.0.0.1:6379
REHEARSAL_STATE_DIR=.state

# Paid actions stay disabled until an operator token is configured and used to
# unlock Connections. Use a random token of at least 32 characters. Never commit it.
REHEARSAL_OPERATOR_TOKEN=
# Rolling, workspace-wide quotas, reserved before requests and retained on reset.
REHEARSAL_LIVE_RUNS_PER_HOUR=3
REHEARSAL_LIVE_RUNS_PER_DAY=6
REHEARSAL_PROVIDER_REQUESTS_PER_DAY=60
# Public visitors can inspect the workspace and run isolated examples.
# Only an authenticated operator can edit shared state. External MCP is disabled.
REHEARSAL_PUBLIC=0
# Required when serving behind a public HTTPS reverse proxy.
# REHEARSAL_PUBLIC_ORIGIN=https://your-demo.example

# Real repository workflow. Docker is local-only; hosted execution uses Vercel VMs.
REHEARSAL_SANDBOX=disabled
# REHEARSAL_SANDBOX=docker
# REHEARSAL_RUNNER_IMAGE=rehearsal-runner:local
# REHEARSAL_SANDBOX=vercel
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# Alternatively, share a random 48+ character secret between the Vercel function
# and API for automatically rotated project identity. No Vercel PAT is needed.
# REHEARSAL_SANDBOX_BROKER_SECRET=
# Frontend origin, including the OAuth callback and same-origin API proxy.
# REHEARSAL_APP_ORIGIN=https://your-project.vercel.app
# Vercel build setting: persistent API origin (not a secret).
# REHEARSAL_API_ORIGIN=https://your-api.onrender.com
# GitHub OAuth application. Client secret is server-only.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Required in public mode for encrypted GitHub tokens. Generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# REHEARSAL_SESSION_KEY=
REHEARSAL_REPO_RUNS_PER_HOUR=4
REHEARSAL_REPO_RUNS_PER_DAY=12
REHEARSAL_REPO_MODEL_REQUESTS_PER_DAY=24
# Optional temporary public demo (no hosting subscription).
# REHEARSAL_TEMPORARY_DEMO=1
